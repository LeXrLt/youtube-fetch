{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "is_relevant": {
      "type": "boolean"
    },
    "filter_reason": {
      "type": "string"
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "background_notes": {
      "type": "string"
    },
    "guests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name_original": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": ["string", "null"],
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": ["name_original", "title"],
        "additionalProperties": false
      }
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["name", "category", "description", "confidence"],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["title", "url", "note"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "is_relevant",
    "filter_reason",
    "relevance_score",
    "quality_score",
    "summary",
    "background_notes",
    "guests",
    "key_points",
    "tags",
    "sources"
  ],
  "additionalProperties": false
}
